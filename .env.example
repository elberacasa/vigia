# Optional keys. Vigía works with none of them. The setup guide at /guia is the easy way to add a key: it checks
# each one live and saves it on this machine only. Environment variables (or this file, copied to .env, which Bun
# loads and git ignores) are for developers; a key saved from the guide takes precedence over the same key here.

# Fires and gas flares (NASA FIRMS; free, no card): https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=

# Optional AI section, paid per use and never spent beyond the budget you set in the app:
# TypeSafe (Jev) fast classifier: https://typesafe.ai
TYPESAFE_API_KEY=
# Anthropic (Claude) for the written brief: https://console.anthropic.com
ANTHROPIC_API_KEY=
