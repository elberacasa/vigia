# Vigía works with none of these. On your own computer, add keys in the app's setup guide (/guia): it checks each
# key live and saves it on this machine only. This file is for servers, Docker and developers: copy it to .env
# (Bun loads it; git ignores it). A key saved from the guide takes precedence over the same key here.

# ---- Optional keys (free unless marked) ----

# Fires and gas flares, with far less data downloaded (NASA FIRMS; email only, no card):
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=

# Guri reservoir level from satellite altimetry (DAHITI, TU Munich; free account, no card):
# https://dahiti.dgfi.tum.de/en/register/
DAHITI_API_KEY=

# Public cameras registered on Windy in Venezuela, Cúcuta and the ABC islands (list and player only; free Windy
# account): https://api.windy.com/keys
WINDY_WEBCAMS_KEY=

# Cloudflare Radar: outages, traffic anomalies and traffic for Venezuela (free account, custom token with
# Account > Radar > Read; no card): https://dash.cloudflare.com/sign-up
CLOUDFLARE_RADAR_TOKEN=

# Ships seen by satellite radar near the oil terminals, and how many had AIS off (Global Fishing Watch; free
# account, non-commercial API token): https://globalfishingwatch.org/our-apis/tokens
GLOBAL_FISHING_WATCH_TOKEN=

# ReliefWeb (OCHA) reports and disasters on Venezuela: an API appname ReliefWeb approves on request (short form, no
# card; only an organisation's official email is considered; reliefweb.int refuses automated readers):
# https://apidoc.reliefweb.int/parameters#appname
RELIEFWEB_APPNAME=

# Optional AI section, PAID per use and never spent beyond the budget you set in the app:
# TypeSafe (Jev) fast news classifier: https://typesafe.ai
TYPESAFE_API_KEY=
# Anthropic (Claude) for the written daily brief: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---- Server settings (all optional; defaults shown) ----

# VIGIA_PORT=7722
# VIGIA_HOST=127.0.0.1            # 0.0.0.0 serves your local network; keys still change only from this computer
# VIGIA_MODE=local                # public = read-only mirror: every write refused, no session link
# VIGIA_CORS=                     # 1 = other sites may read /api/v1 (default: on in public mode, off locally)
# VIGIA_METRICS=loopback          # who may read /metrics: loopback | off | open
# VIGIA_TRUST_PROXY=              # proxy addresses or CIDRs whose X-Forwarded-For is trusted
# VIGIA_LOG_FORMAT=text           # text | json
# VIGIA_BCV_API=on                # 0/off: don't use bcv-api as the BCV rate's second route
# VIGIA_NO_OPEN=0                 # 1: don't open the browser at start
# VIGIA_NO_FETCH=0                # 1: serve what is stored without fetching any source
